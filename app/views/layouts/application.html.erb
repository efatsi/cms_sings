<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Camp Songs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Open+Sans:wght@400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen" style="background-color: #f4ede0; font-family: 'Open Sans', sans-serif;">
    <nav class="py-4 px-6 border-b border-opacity-20" style="background-color: #537326; border-color: rgba(255,255,255,0.2);">
      <div class="max-w-3xl mx-auto flex items-center justify-between">
        <%= link_to root_path, class: "text-white no-underline" do %>
          <span class="text-xl font-semibold" style="font-family: 'Lora', serif;">Camp Songs</span>
        <% end %>
      </div>
    </nav>

    <main class="max-w-3xl mx-auto px-6 py-8">
      <%= yield %>
    </main>
  </body>
</html>
