<div data-controller="player">
  <%# Hidden audio element %>
  <audio data-player-target="audio"
         data-action="ended->player#ended timeupdate->player#updateProgress loadedmetadata->player#updateDuration"
         class="hidden"></audio>

  <%# Header %>
  <div class="flex items-start justify-between mb-6 gap-4">
    <div>
      <%= link_to albums_path, class: "text-sm mb-2 inline-flex items-center gap-1 no-underline hover:underline", style: "color: #537326;" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        All albums
      <% end %>
      <h1 class="text-2xl font-semibold" style="font-family: 'Lora', serif; color: #537326;"><%= @album.name %></h1>
      <p class="text-sm text-stone-500 mt-1"><%= @tracks.count %> tracks</p>
    </div>

    <%# Autoplay toggle %>
    <div class="flex items-center gap-2 mt-1 shrink-0">
      <span class="text-sm text-stone-500">Autoplay</span>
      <button data-player-target="autoplayToggle"
              data-action="click->player#toggleAutoplay"
              class="relative inline-flex items-center w-10 h-6 rounded-full transition-colors focus:outline-none"
              style="background-color: #537326;"
              title="Toggle autoplay">
        <span data-player-target="toggleKnob"
              class="inline-block w-4 h-4 bg-white rounded-full shadow transition-transform translate-x-5"></span>
      </button>
    </div>
  </div>

  <%# Track list %>
  <div class="rounded-xl border border-amber-200 overflow-hidden bg-white bg-opacity-50 mb-28">
    <% @tracks.each do |track| %>
      <div class="group flex items-center border-b border-amber-100 last:border-b-0 cursor-pointer transition-colors hover:bg-amber-50"
           data-player-target="row"
           data-track-id="<%= track.id %>"
           data-stream-url="<%= stream_track_path(track) %>"
           data-track-name="<%= track.display_name %>"
           data-action="click->player#play">
        <%# Play/pause icon %>
        <div class="w-12 flex items-center justify-center shrink-0 py-3">
          <svg data-player-target="playIcon" class="w-5 h-5 text-stone-400 opacity-0 group-hover:opacity-100 transition-opacity" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg data-player-target="pauseIcon" class="w-5 h-5 hidden" style="color: #537326;" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
          </svg>
        </div>

        <%# Track name %>
        <div class="flex-1 py-3 pr-4">
          <span class="text-sm"><%= track.display_name %></span>
        </div>

        <%# Track number %>
        <div class="w-8 text-right pr-4 text-xs text-stone-400 shrink-0">
          <%= track.position + 1 %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Now Playing bar %>
  <div data-player-target="nowPlaying"
       class="fixed bottom-4 right-4 w-80 rounded-2xl shadow-2xl border border-amber-100 hidden overflow-hidden"
       style="background-color: #fdfaf5;">

    <div class="px-5 pt-4 pb-2">
      <p class="text-xs font-medium uppercase tracking-widest mb-1" style="color: #537326;">Now Playing</p>
      <p class="text-sm font-semibold text-stone-800 truncate" data-player-target="nowPlayingTitle">—</p>
    </div>

    <%# Progress bar %>
    <div class="px-5 pb-3">
      <div class="relative h-1.5 bg-stone-200 rounded-full">
        <div class="absolute inset-y-0 left-0 rounded-full" style="background-color: #537326; width: 0%;" data-player-target="progressFill"></div>
        <input type="range" min="0" max="100" value="0" step="0.1"
               data-player-target="progressBar"
               data-action="input->player#seek"
               class="absolute inset-0 w-full h-full opacity-0 cursor-pointer m-0 p-0">
      </div>
      <div class="flex justify-between text-xs text-stone-400 mt-1.5">
        <span data-player-target="currentTime">0:00</span>
        <span data-player-target="durationDisplay">0:00</span>
      </div>
    </div>

    <%# Controls %>
    <div class="flex items-center justify-center gap-8 pb-5">
      <button data-action="click->player#previous"
              class="text-stone-400 hover:text-stone-700 transition-colors"
              title="Previous / Restart">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/>
        </svg>
      </button>

      <button data-action="click->player#togglePlayPause"
              class="w-11 h-11 rounded-full flex items-center justify-center text-white shadow-md transition-transform hover:scale-105"
              style="background-color: #537326;">
        <svg data-player-target="nowPlayingPlayIcon" class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg data-player-target="nowPlayingPauseIcon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
      </button>

      <button data-action="click->player#next"
              class="text-stone-400 hover:text-stone-700 transition-colors"
              title="Next">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 18 14.5 12 6 6v12zm8.5-12v12h2V6h-2z"/>
        </svg>
      </button>
    </div>
  </div>
</div>
